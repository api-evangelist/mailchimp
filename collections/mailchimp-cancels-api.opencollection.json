{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mailchimp Marketing Abuse Cancels API",
    "version": "3.0.55"
  },
  "items": [
    {
      "info": {
        "name": "Cancels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mailchimp Cancel Campaign",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/campaigns/:campaign_id/actions/cancel-send",
            "params": [
              {
                "name": "campaign_id",
                "value": "500123",
                "type": "path",
                "description": "The unique id for the campaign."
              }
            ]
          },
          "docs": "Cancel a Regular or Plain-Text Campaign after you send, before all of your recipients receive it. This feature is included with Mailchimp Pro."
        }
      ]
    }
  ],
  "bundled": true
}